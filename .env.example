# ── Netlify environment variables (Site configuration → Environment variables) ──
# These are read ONLY by the server-side Netlify Functions. Never prefix them
# with VITE_ (that would publish them inside the website's JavaScript).

# The /exec URL of the Apps Script Web App (Deploy → Manage deployments)
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Same value as the RSVP_SHARED_SECRET Script Property (64 hex chars).
# Generated for you by "Birthday Invitations → Setup", or: openssl rand -hex 32
RSVP_SHARED_SECRET=

# Optional: extra allowed origins, comma-separated (e.g. your custom domain).
# The site's own origin is always allowed.
ALLOWED_ORIGIN=https://your-site.netlify.app

# Optional: absolute site URL for link previews. Netlify sets URL automatically.
SITE_URL=
